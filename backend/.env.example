# Copy to .env and load with: .venv/bin/uvicorn app.main:app --env-file .env

# HS256 signing secret, at least 32 characters (shorter values are refused at startup).
# If empty, a random secret is generated per process (tokens die on restart). Generate one:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=60

# test (synthetic pattern) | webcam | file:/absolute/path/to/video.mp4
VIDEO_SOURCE=test
VIDEO_DEVICE=/dev/video0

# Used by `python -m app`; with the uvicorn CLI pass --host/--port instead.
HOST=0.0.0.0
PORT=8010

# Comma separated; "*" allows any origin (Flutter web dev server uses a random port).
CORS_ORIGINS=*

# Comma separated STUN URLs for the server's peer connections; empty = host candidates only.
STUN_SERVERS=stun:stun.l.google.com:19302

LOG_LEVEL=INFO
